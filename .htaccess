<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Storage files → Laravel storage (symlink bypass)
  RewriteCond %{REQUEST_URI} ^/storage/
  RewriteRule ^storage/(.*)$ backend/storage/app/public/$1 [L]

  # API requests → Laravel backend
  RewriteCond %{REQUEST_URI} ^/api
  RewriteRule ^(.*)$ backend/public/index.php [QSA,L,E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Redirect everything to the dist folder
  RewriteRule ^$ dist/index.html [L]
  
  # Check if the requested file exists in dist
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ dist/$1 [L]
  
  # Handle SPA routing by sending non-file requests to dist/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{REQUEST_URI} !^/ovr
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>
